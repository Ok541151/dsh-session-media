{
  "name": "dsh-session-media",
  "version": "0.3.4",
  "description": "Session-archive layer for DeepSeek Harness: per-workspace memory injection, cross-session keyword search, and attachment recovery (original blob paths, bulk export).",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "cismoke.mjs",
    "selftest.mjs"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "memory",
    "attachment",
    "media"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "smoke": "node cismoke.mjs",
    "test": "node selftest.mjs",
    "test:fast": "node selftest.mjs --no-evict"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ok541151/dsh-session-media.git"
  },
  "homepage": "https://github.com/Ok541151/dsh-session-media#readme",
  "bugs": {
    "url": "https://github.com/Ok541151/dsh-session-media/issues"
  },
  "license": "MIT"
}